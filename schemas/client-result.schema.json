{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sunspec-interop client result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapter",
    "operation",
    "host",
    "port",
    "unitId",
    "ok"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "adapter": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "scan",
        "write"
      ]
    },
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "unitId": {
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "connect",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "result"
    ]
  },
  "else": {
    "required": [
      "error"
    ]
  }
}
